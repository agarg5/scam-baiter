# ── Vocal Bridge ───────────────────────────────────────────────────────────────
# Get your API key from vocalbridgeai.com → Dashboard → API Keys
VOCAL_BRIDGE_API_KEY=vb_your_api_key_here

# Map each persona to a VB agent ID. Create agents in the VB dashboard,
# set their prompts to match the persona's systemPrompt, then paste the
# agent UUID here. The env var pattern is VOCALBRIDGE_AGENT_<PERSONA_ID>.
VOCALBRIDGE_AGENT_TYLER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VOCALBRIDGE_AGENT_MARGARET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Fallback agent ID used when a persona has no agent mapping:
# VOCALBRIDGE_DEFAULT_AGENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── SignalWire (Twilio-compatible) ─────────────────────────────────────────────
# Required for SMS. https://signalwire.com
SIGNALWIRE_PROJECT_ID=your-project-id
SIGNALWIRE_API_TOKEN=your-api-token
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PHONE_NUMBER=+1xxxxxxxxxx

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Used for SMS replies and the offline simulator
OPENAI_API_KEY=your-openai-api-key

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# Which persona to use by default (filename under prompts/, without .js)
DEFAULT_PERSONA=tyler

# Public URL of this server. Used by the batch dialer AND for webhook signature
# validation (the signature is computed over this URL). Set it to your tunnel /
# deployed host so signature checks pass behind a proxy.
# PUBLIC_HOST=https://your-tunnel.trycloudflare.com

# ── Security (all optional, but strongly recommended on a public tunnel) ──────
# Shared secret required to place outbound calls (POST /api/call). The batch
# dialer sends it automatically. If unset, the endpoint is UNPROTECTED.
# API_SECRET=change-me-to-a-long-random-string

# Key for the /dashboard log viewer (?key=...). Falls back to API_SECRET if
# unset. If neither is set, the dashboard is UNPROTECTED.
# DASHBOARD_KEY=change-me-too

# SignalWire signs every webhook with X-Twilio-Signature; we validate it using
# SIGNALWIRE_API_TOKEN above. Set this to 'true' ONLY for local testing without
# a real provider (e.g. curling the endpoints yourself).
# SKIP_SIGNATURE_VALIDATION=false
