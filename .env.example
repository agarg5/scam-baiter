# ElevenLabs Conversational AI — https://elevenlabs.io/app/conversational-ai
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# SignalWire (Twilio-compatible) — https://signalwire.com
SIGNALWIRE_PROJECT_ID=your-project-id
SIGNALWIRE_API_TOKEN=your-api-token
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PHONE_NUMBER=+1xxxxxxxxxx

# OpenAI — used for SMS replies
OPENAI_API_KEY=your-openai-api-key

# Server
PORT=8000

# Which persona to use by default (filename under prompts/, without .js)
DEFAULT_PERSONA=tyler

# Optional: public URL of this server (for the batch dialer)
# PUBLIC_HOST=https://your-tunnel.trycloudflare.com
