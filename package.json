{
  "name": "scam-baiter",
  "version": "1.0.0",
  "description": "Scam-baiting voice bot using VocalBridge + OpenAI",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch & node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "batch": "node dist/scripts/batch-call.js",
    "prebatch": "tsc",
    "sim": "node dist/scripts/sim.js",
    "presim": "tsc",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "pretest": "tsc"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "openai": "^4.0.0",
    "twilio": "^6.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.4.0"
  }
}
